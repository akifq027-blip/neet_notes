# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ================================================================
# NEET NOTES MARKETPLACE CONFIGURATION
# ================================================================

# --- MySQL Database Configuration ---
# Enter your own MySQL credentials below.
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="neet_notes_db"
DB_PORT="3306"

# --- Authentication / Security ---
JWT_SECRET="neet_super_secure_jwt_secret_key_change_in_production_2025"
JWT_EXPIRES_IN="7d"

# --- Razorpay Payment Gateway ---
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_TW9S6IV6qcqE6z"
RAZORPAY_KEY_SECRET="9H4HsrYO3RifyvtDVYralneJ"

# --- Merchant UPI & Instant Payment Configuration (Google Pay / PhonePe / Paytm) ---
# Server-side only: never exposed directly in frontend code
MERCHANT_UPI_ID="neetnotes@icici"
MERCHANT_NAME="NEET Notes HQ"
ENABLE_DIRECT_UPI="true"

